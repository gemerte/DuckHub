	-- Флаг, чтобы способность Fort на высоте прожалась только ОДИН раз за цикл фарминга
	local abilityUsedOnHeight = false 

	game:GetService("RunService").Heartbeat:Connect(function()
		if not plankButton or not plankButton.Parent then return end
		if not plankFarmActive then return end

		local player = game:GetService("Players").LocalPlayer
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")

		if char and root then
			-- 1. Проверяем, держит ли игрок перчатку Fort
			local currentTool = char:FindFirstChildOfClass("Tool")
			
			if not currentTool or currentTool.Name ~= "Fort" then
				alertLabel.Visible = true
				abilityUsedOnHeight = false -- Сбрасываем флаг, если игрок убрал перчатку
				return 
			else
				alertLabel.Visible = false
			end

			-- 2. ЭТАП ВЫСОТЫ: Если перчатка Fort в руках, но способность еще не была прожата на высоте
			if not abilityUsedOnHeight then
				root.Velocity = Vector3.new(0, 0, 0)
				-- Телепортируем игрока на безопасную огромную высоту (5000 студий вверх)
				root.CFrame = CFrame.new(root.Position.X, 5000, root.Position.Z)
				
				task.wait(0.5) -- Короткая пауза, чтобы физика персонажа стабилизировалась на высоте
				
				-- Автоматически активируем (прожимаем способность) перчатки Fort
				currentTool:Activate() 
				abilityUsedOnHeight = true -- Запоминаем, что форт на высоте успешно построен
				return
			end

			-- 3. Проверка получения бейджа
			local hasBadge = false
			pcall(function()
				hasBadge = game:GetService("BadgeService"):UserHasBadgeAsync(player.UserId, plankBadgeId)
			end)

			if hasBadge then
				plankFarmActive = false
				alertLabel.Visible = false
				plankButton.Text = "  Plank ПОЛУЧЕН! ✅"
				plankButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
				return
			end

			-- 4. Телепорт вниз к появившемуся объекту crack'90
			local targetObject = workspace:FindFirstChild("Plank") 
				or workspace:FindFirstChild("Crack") 
				or (workspace:FindFirstChild("Arena") and (workspace.Arena:FindFirstChild("Plank") or workspace.Arena:FindFirstChild("Crack")))

			if targetObject and targetObject:IsA("BasePart") then
				root.Velocity = Vector3.new(0, 0, 0)
				root.CFrame = targetObject.CFrame * CFrame.new(0, 2, 0) 
			end
		end
	end)
