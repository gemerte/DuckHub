local visualTick = 0
local activeTrails = {}

-- Функция для создания красивого следа (Trail) на перчатке
local function applyGloveTrail(glove)
	if not glove:IsA("Tool") or activeTrails[glove] then return end
	
	local handle = glove:FindFirstChild("Handle") or glove:FindFirstChildOfClass("BasePart")
	if not handle then return end
	
	-- Создаем две точки, между которыми будет натянут след
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = handle
	
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = handle
	
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.LightEmission = 0.8
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0)
	})
	trail.Parent = handle
	
	activeTrails[glove] = {trail = trail, a0 = a0, a1 = a1}
end

game:GetService("RunService").RenderStepped:Connect(function()
	if not blurButton or not blurButton.Parent then return end -- Защита от удаления меню
	visualTick = visualTick + 1
	
	local player = game:GetService("Players").LocalPlayer
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	
	-- Рассчитываем цвет радуги
	local r = math.sin(visualTick * 0.05) * 127 + 128
	local g = math.sin(visualTick * 0.05 + 2) * 127 + 128
	local b = math.sin(visualTick * 0.05 + 4) * 127 + 128
	local rainbowColor = Color3.fromRGB(r, g, b)
	
	-- 1. ЛОГИКА RGB СЛЕДА ДЛЯ ПЕРЧАТКИ
	if char and visualSettings.gloveRgb then
		local glove = char:FindFirstChildOfClass("Tool")
		if glove then
			applyGloveTrail(glove)
			if activeTrails[glove] then
				activeTrails[glove].trail.Enabled = true
				activeTrails[glove].trail.Color = ColorSequence.new(rainbowColor)
			end
		end
	else
		-- Если выключено, гасим все активные трейлы
		for glove, data in pairs(activeTrails) do
			if data.trail and data.trail.Parent then data.trail.Enabled = false end
		end
	end
	
	-- 2. ЛОГИКА MOTION BLUR (РАЗМЫТИЯ) ОТ СКОРОСТИ
	if root and hum and visualSettings.motionBlur then
		local velocity = root.Velocity.Magnitude
		if velocity > 16 then
			-- Чем быстрее бежишь/летишь от шлепка, тем сильнее размытие экрана
			blurEffect.Size = math.clamp((velocity - 16) * 0.3, 0, 12)
		else
			blurEffect.Size = 0
		end
	else
		blurEffect.Size = 0
	end
end)


