	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.Parent = pageContainer

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = pageContainer
	
	pages[name] = pageContainer
	table.insert(activeButtons, btn)

	btn.MouseButton1Click:Connect(function()
		currentActiveButton = btn
		for _, otherBtn in ipairs(activeButtons) do
			if otherBtn ~= btn then otherBtn.BackgroundColor3 = BTN_DEFAULT end
		end
		for _, page in pairs(pages) do page.Visible = false end
		pageContainer.Visible = true
	end)

	return btn
end

