-- Функция создания красивой ударной волны вокруг игрока
local function spawnWaveEffect(rootPart)
	local wave = Instance.new("Part")
	wave.Size = Vector3.new(1, 0.2, 1)
	wave.CFrame = rootPart.CFrame * CFrame.new(0, -2, 0) -- Спавним под ногами
	wave.Anchored = true
	wave.CanCollide = false
	wave.Material = Enum.Material.Neon
	wave.Color = Color3.fromRGB(255, 165, 0) -- Яркий оранжевый неоновый импульс
	wave.Shape = Enum.PartType.Cylinder
	wave.Orientation = Vector3.new(0, 0, 90) -- Поворачиваем боком, чтобы получить кольцо на земле
	wave.Parent = workspace

	-- Скругляем края цилиндра, превращая его в красивый диск
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Cylinder
	mesh.Parent = wave

	-- Анимация расширения и растворения волны
	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local tween = tweenService:Create(wave, tweenInfo, {
		Size = Vector3.new(0.2, 35, 35), -- Цилиндр расширяется в стороны на 35 студий
		Transparency = 1
	})
	
	tween:Play()
	tween.Completed:Connect(function()
		wave:Destroy()
	end)
end

-- Функция эпичной тряски камеры (Cinematic Shake)
local function shakeCamera()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local originalSubjectPosition = camera.CameraSubject
	
	task.spawn(function()
		for i = 1, 6 do
			local offsetX = math.random(-50, 50) / 100
			local offsetY = math.random(-50, 50) / 100
			local offsetZ = math.random(-50, 50) / 100
			camera.CFrame = camera.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
			task.wait(0.02)
		end
	end)
end

