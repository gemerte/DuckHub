	["Default"] = {oneShot = "Нет 🗿", power = "30"},
	["Extended"] = {oneShot = "Нет 🗿", power = "35"}
}

-- Стабильный поиск перчаток без падений скрипта
local function getGlove(player)
	local char = player.Character
	if char then
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then return tool.Name end
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Glove") then return tostring(ls.Glove.Value) end
	return "None"
end

-- Точечная и безопасная очистка объектов ESP при выключении функции
local function clearESP(char)
	if char and char:FindFirstChild("HubHighlight") then char.HubHighlight:Destroy() end
	if char and char:FindFirstChild("Head") and char.Head:FindFirstChild("HubBillboard") then
		char.Head.HubBillboard:Destroy()
	end
end

-- Полностью изолированный цикл слежки (Force-сканирование арены)
task.spawn(function()
	while task.wait(0.4) do
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
				local char = p.Character
				local head = char.Head

				if flags.mainEsp then
					-- 1. Подсветка силуэта (Highlight) — Работает всегда, пока горит главная кнопка ESP
					local hl = char:FindFirstChild("HubHighlight")
					if not hl then
						hl = Instance.new("Highlight")
						hl.Name = "HubHighlight"
						hl.FillColor = Color3.fromRGB(255, 50, 50)
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.FillTransparency = 0.5
						hl.Parent = char
					end
					hl.Enabled = true

					-- 2. Логика Текста — Отрендерится, только если активен хоть один флаг информации
					local isAnyTextActive = flags.gloves or flags.oneshot or flags.knockback
					local bgui = head:FindFirstChild("HubBillboard")

					if isAnyTextActive then
						local tLabel
						if not bgui then
							bgui = Instance.new("BillboardGui")
							bgui.Name = "HubBillboard"
							bgui.AlwaysOnTop = true
							bgui.Size = UDim2.new(0, 200, 0, 70)
							bgui.ExtentsOffset = Vector3.new(0, 3.5, 0)
							
							tLabel = Instance.new("TextLabel")
							tLabel.Name = "HubText"
							tLabel.Size = UDim2.new(1, 0, 1, 0)
							tLabel.BackgroundTransparency = 1
							tLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
							tLabel.TextStrokeTransparency = 0 -- Обводка букв
							tLabel.Font = Enum.Font.GothamBold
							tLabel.TextSize = 12
							tLabel.Parent = bgui
							bgui.Parent = head
						else
							tLabel = bgui:FindFirstChild("HubText")
						end

						if tLabel then
							local currentGlove = getGlove(p)
							local info = gloveData[currentGlove] or {oneShot = "Нет ❌", power = "Обычная"}

							local text = "[" .. p.DisplayName .. "]"
							if flags.gloves then text = text .. "\n🧤 Перчатка: " .. currentGlove end
							if flags.oneshot then text = text .. "\n💀 Ваншот: " .. info.oneShot end
							if flags.knockback then text = text .. "\n💥 Сила: " .. info.power end
							
							tLabel.Text = text
							bgui.Enabled = true
						end
					else
						-- Если текстовые функции отжаты, стираем BillboardGui, оставляя чистый Highlight
						if bgui then bgui:Destroy() end
					end
				else
					-- Если полностью вырубили ESP кнопкой
					clearESP(char)
				end
			end
		end
	end
end)


