		if myRoot and myHumanoid then
			-- Проверка: получили ли мы уже бейдж? Если да — выключаем скрипт автоматически
			local hasBadge = false
			pcall(function()
				hasBadge = BadgeService:UserHasBadgeAsync(LocalPlayer.UserId, tycoonBadgeId)
			end)
			
			if hasBadge then
				tycoonFarmActive = false
				tycoonButton.Text = "  Tycoon ПОЛУЧЕН! ✅"
				tycoonButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
				return
			end
			
			-- Логика авто-входа на арену (если мы умерли и возродились в лобби)
			if myRoot.Position.Y < -50 then 
				-- Ищем красный портал в лобби (обычно называется "ArenaPortal" или "Portal")
				local portal = Workspace:FindFirstChild("ArenaPortal") or Workspace:FindFirstChild("Portal")
				if portal and portal:IsA("BasePart") then
					myRoot.CFrame = portal.CFrame
				end
				return
			end
			
			-- ПОИСК ТАРЕЛКИ НА КАРТЕ SLAP BATTLES
			-- В игре тарелка обычно лежит по пути Workspace.Arena.Plate или просто называется "Plate"
			local plate = Workspace:FindFirstChild("Plate") or (Workspace:FindFirstChild("Arena") and Workspace.Arena:FindFirstChild("Plate"))
			
			if plate and plate:IsA("BasePart") then
				-- Сбрасываем инерцию падения, чтобы персонаж не улетел от прыжка тарелки
				myRoot.Velocity = Vector3.new(0, 0, 0)
				
				-- "Приклеиваем" игрока ровно по центру тарелки, приподняв на 3.5 студии вверх
				-- Так как тарелка крутится, CFrame будет двигать тебя синхронно с ней каждую миллисекунду
				myRoot.CFrame = plate.CFrame * CFrame.new(0, 3.5, 0)
			end
		end
	end)
end)



