local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- База данных популярных перчаток Slap Battles
local gloveData = {
	["Overkill"] = {oneShot = "ДА ✅", power = "ВАНШОТ 🔥"},
	["Error"] = {oneShot = "ДА ✅", power = "ВАНШОТ 🔥"},
