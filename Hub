-- Переменные для запоминания исходного размера и состояния
local isMinimized = false
local originalSize = UDim2.new(0, 480, 0, 320)
local minimizedSize = UDim2.new(0, 180, 0, 40) -- Размер полосочки при сворачивании
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

minimizeBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	
	if isMinimized then
		minimizeBtn.Text = "+"
		
		-- Плавно скрываем все внутренние элементы меню (боковую панель и страницы)
		for _, child in ipairs(mainFrame:GetChildren()) do
			if child:IsA("Frame") then
				child.Visible = false
			end
		end
		
		-- Запускаем красивую анимацию сжатия фрейма
		local shrinkTween = TweenService:Create(mainFrame, tweenInfo, {Size = minimizedSize})
		shrinkTween:Play()
	else
		minimizeBtn.Text = "—"
		
		-- Сначала плавно возвращаем исходный размер меню
		local expandTween = TweenService:Create(mainFrame, tweenInfo, {Size = originalSize})
		expandTween:Play()
		
		-- Ждём окончания анимации перед тем, как показать интерфейс обратно
		expandTween.Completed:Connect(function()
			if not isMinimized then -- Проверка на случай, если игрок кликнул слишком быстро
				for _, child in ipairs(mainFrame:GetChildren()) do
					-- Показываем обратно боковую панель и контейнер страниц
					if child.Name == "SidePanel" or child.Name == "Pages" then
						child.Visible = true
					end
				end
			end
		end)
	end
end)

-- Плавное перетаскивание хуба мышкой (Не блокирует ScrollingFrame и работает для полосочки)
local UserInputService = game:GetService("UserInputService")
local dragging, dragInput, dragStart, startPos
local function update(input)
	local delta = input.Position - dragStart
	mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true; dragStart = input.Position; startPos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then update(input) end
end)

