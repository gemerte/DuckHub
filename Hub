-- Метод переключения видимости страниц
local function showPage(targetPage)
	for _, page in ipairs(pagesContainer:GetChildren()) do
		if page:IsA("Frame") then
			page.Visible = (page == targetPage)
		end
	end
end

-- Назначаем действия кнопкам
