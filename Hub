-- =============================================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

-- Настройки ауры ударов
local auraSettings = {
	enabled = true,     -- Поставь false, если хочешь изначально выключить функцию
	distance = 15,      -- Радиус удара в студиях (15 — оптимально для обычных перчаток)
}

-- Функция для безопасного поиска и активации перчатки в руке
local function slapTarget(targetChar)
	local char = LocalPlayer.Character
	if not char then return end

	-- Ищем перчатку, которая сейчас экипирована (взята в руки)
	local glove = char:FindFirstChildOfClass("Tool")
	if glove then
		-- Slap Battles использует стандартный метод .Activate() для удара рукой
		glove:Activate()
	end
end

-- Изолированный быстрый поток для отслеживания дистанции до врагов
task.spawn(function()
	-- Используем Heartbeat для моментальной реакции (каждый кадр игры)
	RunService.Heartbeat:Connect(function()
		if not auraSettings.enabled then return end

		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end

		-- Перебираем всех игроков на сервере
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local enemyChar = p.Character
				local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
				local enemyHumanoid = enemyChar:FindFirstChildOfClass("Humanoid")

				-- Проверяем: жив ли враг, есть ли у него хитбокс и не находится ли он в лобби
				if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 then
					-- Считаем точное расстояние между тобой и целью
					local dist = (myRoot.Position - enemyRoot.Position).Magnitude

					if dist <= auraSettings.distance then
						-- Если игрок подошел близко — бьем его перчаткой
						slapTarget(enemyChar)
					end
				end
			end
		end
	end)
end)

