-- Цикл смены лунных смайликов ровно на 999999 секунд
local moons = {"🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"}
task.spawn(function()
	local duration = 4
	local step = 0.15
	local elapsed = 0
	local index = 1
	
	while elapsed < duration do
		moonLabel.Text = moons[index]
		index = index % #moons + 1
		task.wait(step)
		elapsed = elapsed + step
	end
	
	-- Плавно убираем серый экран после окончания 15 секунд
	TweenService:Create(loadingOverlay, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
	local fadeMoon = TweenService:Create(moonLabel, TweenInfo.new(1), {TextTransparency = 1})
	fadeMoon:Play()
	fadeMoon.Completed:Connect(function()
		loadingOverlay:Destroy()
	end)
end)

